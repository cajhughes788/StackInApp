{
  "_about": "Real-style sentences for clients by voice, scored by scripts/eval-voice-client.cjs. mode 'add' = the Add client form; 'note' = Say a note on a client's page. Fields left out of 'expect' must come back null (remove and others empty; for notes, 'notesHas' lists words that must all appear; 'addressHas' likewise). Names and emails compare ignoring case; phones by digits. Add a case whenever someone's real sentence fills it wrong.",
  "cases": [
    {
      "mode": "add",
      "say": "New client Jenna Morales, 509 555 0142, jenna at gmail dot com",
      "expect": {
        "name": "Jenna Morales",
        "phone": "5095550142",
        "email": "jenna@gmail.com"
      }
    },
    {
      "mode": "add",
      "say": "Add Marcus Lee, his number is 208-555-0199",
      "expect": {
        "name": "Marcus Lee",
        "phone": "2085550199"
      }
    },
    {
      "mode": "add",
      "say": "new client Priya Patel email priya dot patel at outlook dot com she lives at 12 Oak Street Spokane",
      "expect": {
        "name": "Priya Patel",
        "email": "priya.patel@outlook.com",
        "addressHas": [
          "12 Oak",
          "Spokane"
        ]
      }
    },
    {
      "mode": "add",
      "say": "Add Olivia Chen, allergic to ammonia, prefers Tuesdays, referred by Marcus",
      "expect": {
        "name": "Olivia Chen",
        "notesHas": [
          "ammonia",
          "Tuesday",
          "Marcus"
        ]
      }
    },
    {
      "mode": "add",
      "say": "New client Dana Fox, email d a n a f o x at yahoo dot com",
