# Copy this file to .env.recording and fill in real values.
# .env.recording is gitignored (see .gitignore: ".env.*") — never commit it.

# Existing StackIn account to log in as. Must have an ACTIVE subscription
# (workspace creation is gated on this) and enough workspace slots free to
# create two new demo workspaces (one W-2, one Independent).
STACKIN_DEMO_EMAIL=you@example.com
STACKIN_DEMO_PASSWORD=

# Base URL of the running app (npm run dev serves this by default).
STACKIN_APP_URL=http://localhost:3000

# Names for the two throwaway workspaces the script creates. Delete them
# from the app afterward if you don't want them cluttering your account.
STACKIN_DEMO_W2_WORKSPACE=Ad Demo (W-2)
STACKIN_DEMO_INDEPENDENT_WORKSPACE=Ad Demo (Independent)

# ElevenLabs API key for narration (npm run narrate:ads). Get one at
# elevenlabs.io — needs a paid plan; the free tier blocks API access to
# library voices entirely ("Free users cannot use library voices via
# the API"), even though those same voices work in their web app.
ELEVENLABS_API_KEY=
# Optional: a specific ElevenLabs voice ID. Defaults to "Rachel" (a
# warm, clear voice commonly used for ads/marketing) if unset.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
