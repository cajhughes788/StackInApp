{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "main": "lib/backend/functions/src/index.js",
  "scripts": {
    "clean": "del-cli lib dist build .tsbuildinfo ../shared/**/*.js ../shared/**/*.d.ts",
    "build": "tsc && tsc-alias",
    "rebuild": "npm run clean && npm run build",
    "serve": "firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "lint": "echo \"(lint disabled)\""
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "decimal.js-light": "^2.5.1",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.6.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "stripe": "^18.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.6.0",
    "eslint": "^8.15.0",
    "eslint-config-google": "^0.14.0",
    "firebase-functions-test": "^3.1.0",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  },
  "private": true,
  "firebase": {
    "predeploy": [
      "npm run build"
    ]
  }
}
