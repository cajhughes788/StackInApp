# Copy to .env (gitignored) — Firebase loads it into every function at deploy.

# StackIn Content Log (Google Sheet) — Apps Script web app URL that receives
# one row per signup. Leave unset to skip the webhook (e.g. local dev).
CONTENT_LOG_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# CONTENT_LOG_SECRET is a Secret Manager secret, not a .env value:
#   firebase functions:secrets:set CONTENT_LOG_SECRET
# For the local emulator, put CONTENT_LOG_SECRET=... in .secret.local (gitignored).
